PORT=5000
DATABASE_URL=postgres://postgres:YOUR_DATABASE_PASSWORD@localhost:5432/havenstay_db
JWT_SECRET=replace_with_a_long_random_secret
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
COMPANY_EMAIL=your_company_email@example.com
COMPANY_PHONE=your_company_phone
APP_URL=http://localhost:5173
BOOKING_REMINDER_DELAY_MINUTES=60
REMINDER_INTERVAL_MINUTES=15

# Signup email verification
EMAIL_VERIFICATION_TTL_MINUTES=15
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Brevo transactional email
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_NAME=HavenStay
# Must be a verified sender/domain in your Brevo account
BREVO_SENDER_EMAIL=your_verified_sender@example.com
