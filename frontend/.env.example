# Set this in Vercel to the deployed backend URL, including /api.
VITE_API_BASE_URL=http://localhost:5000/api
# VITE_API_URL is also accepted for compatibility with existing deployments.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Google Sign-In web client ID (same value as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id
